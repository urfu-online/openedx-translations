msgid ""
msgstr ""
"Project-Id-Version: proctorx-guide\n"
"Language: zh_CN\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "Инструкция для студентов"
msgstr "学生须知"

msgid "Вернуться в панель управления"
msgstr "返回控制面板"

msgid "Инструкция по прохождению прокторинга"
msgstr "监考考试操作说明"

msgid "Внимательно прочитайте инструкцию перед началом экзамена!"
msgstr "开始考试前请仔细阅读说明！"

msgid "Установка Exam Guard"
msgstr "安装 Exam Guard"

msgid "<strong>Exam Guard (ExamUrFU)</strong> — программа на компьютере, которая записывает камеру, микрофон и экран и проверяет среду экзамена. Экзамен проходит в обычном браузере, а запись идёт из этого приложения."
msgstr "<strong>Exam Guard (ExamUrFU)</strong> 是安装在电脑上的程序，用于录制摄像头、麦克风和屏幕，并检查考试环境。考试在普通浏览器中进行，录制由该程序完成。"

msgid "Совет:"
msgstr "提示："

msgid "Установите Exam Guard заранее. При первом запуске разрешите доступ к камере, микрофону и записи экрана. На время экзамена выключите антивирус и не включайте его, пока попытка не будет отправлена."
msgstr "请提前安装 Exam Guard。首次启动时请允许访问摄像头、麦克风和屏幕录制。考试期间请关闭杀毒软件，在答卷提交之前不要重新打开。"

msgid "Запись на дату экзамена"
msgstr "预约考试日期"

msgid "Перед сдачей экзамена необходимо записаться на конкретную дату через календарь бронирования. Начать экзамен можно только в день записи."
msgstr "考试前必须通过预约日历预约具体日期。只能在预约当天开始考试。"

msgid "Откройте страницу курса"
msgstr "打开课程页面"

msgid "Перейдите в раздел с экзаменом в обычном браузере."
msgstr "在普通浏览器中进入考试部分。"

msgid "Найдите виджет «Запись на прокторинг»"
msgstr "找到「预约监考」组件"

msgid "Он расположен на странице курса рядом с экзаменом."
msgstr "它位于课程页面上、考试旁边。"

msgid "Нажмите «Открыть календарь»"
msgstr "点击「打开日历」"

msgid "Выберите экзамен и доступную дату. Учитывайте количество свободных мест."
msgstr "选择考试和可用日期，并留意剩余名额。"

msgid "Подтвердите запись"
msgstr "确认预约"

msgid "После записи вы увидите подтверждение с выбранной датой."
msgstr "预约后你会看到所选日期的确认信息。"

msgid "Важно:"
msgstr "重要："

msgid "Вы можете перенести запись на другую дату, пока экзамен не начат. После начала экзамена изменить дату нельзя."
msgstr "考试开始前可以把预约改到其他日期。考试开始后不能更改日期。"

msgid "Подтверждение личности"
msgstr "身份确认"

msgid "Перед началом экзамена загрузите <strong>фотографию студенческого билета</strong> кнопкой «Загрузить студенческий билет» на панели прокторинга."
msgstr "考试开始前，请用监考面板上的「上传学生证」按钮上传<strong>学生证照片</strong>。"

msgid "Студенческий билет"
msgstr "学生证"

msgid "Требования к фото документа:"
msgstr "证件照片要求："

msgid "Формат: JPG, PNG или PDF"
msgstr "格式：JPG、PNG 或 PDF"

msgid "Размер: не более 5 МБ"
msgstr "大小：不超过 5 MB"

msgid "Фото должно быть чётким, без бликов"
msgstr "照片应清晰、无反光"

msgid "Все данные должны быть читаемы"
msgstr "所有信息必须可读"

msgid "Подготовьте фото заранее и положите файл на компьютер, с которого будете сдавать экзамен."
msgstr "请提前准备照片，并把文件放在你用来考试的电脑上。"

msgid "Пример: студенческий билет"
msgstr "示例：学生证"

msgid "Проверка оборудования"
msgstr "设备检查"

msgid "Компьютер"
msgstr "电脑"

msgid "Минимум 4 ГБ оперативной памяти"
msgstr "至少 4 GB 内存"

msgid "Планшеты и телефоны не поддерживаются"
msgstr "不支持平板和手机"

msgid "Интернет"
msgstr "网络"

msgid "Стабильное соединение от 2 Мбит/с"
msgstr "稳定连接，不低于 2 Mbit/s"

msgid "Проводное подключение предпочтительнее"
msgstr "优先使用有线网络"

msgid "Избегайте публичных Wi-Fi сетей"
msgstr "避免使用公共 Wi-Fi"

msgid "Камера и микрофон"
msgstr "摄像头和麦克风"

msgid "Веб-камера (встроенная или внешняя)"
msgstr "网络摄像头（内置或外接）"

msgid "Микрофон для записи звука"
msgstr "用于录音的麦克风"

msgid "Ту же камеру и микрофон выберите в проверке оборудования и в Exam Guard кнопкой «Применить»"
msgstr "在设备检查和 Exam Guard 中选择同一摄像头和麦克风，并点击「应用」"

msgid "Рабочее место"
msgstr "考场环境"

msgid "Тихое, хорошо освещённое помещение"
msgstr "安静、光线充足的房间"

msgid "Лицо должно быть чётко видно в камере"
msgstr "脸部必须在摄像头中清晰可见"

msgid "Уберите посторонние предметы"
msgstr "收起无关物品"

msgid "Начало экзамена в день записи"
msgstr "在预约当天开始考试"

msgid "Откройте курс в одном разрешённом браузере"
msgstr "只用一个允许的浏览器打开课程"

msgid "Подойдут Chrome, Edge, Яндекс, Firefox, Opera или Brave. Другие браузеры должны быть закрыты. Второй открытый браузер аннулирует уже начатую попытку."
msgstr "可使用 Chrome、Edge、Yandex、Firefox、Opera 或 Brave。其他浏览器必须关闭。已经开始的考试中再打开第二个浏览器，会使本次尝试作废。"

msgid "Запустите Exam Guard и введите код"
msgstr "启动 Exam Guard 并输入代码"

msgid "На странице экзамена появится код привязки. Введите его в окно ExamUrFU и в браузере нажмите «Разрешить этот компьютер»."
msgstr "考试页面上会出现绑定码。请把它输入 ExamUrFU 窗口，并在浏览器中点击「允许这台电脑」。"

msgid "Проверьте камеру и микрофон"
msgstr "检查摄像头和麦克风"

msgid "В проверке оборудования нажмите «Готово» на нужных устройствах. В Exam Guard выберите те же камеру и микрофон и нажмите «Применить». Во время экзамена картинка камеры в браузере может быть чёрной: она показывается в окне агента."
msgstr "在设备检查中对所需设备确认完成。在 Exam Guard 中选择同一摄像头和麦克风并点击「应用」。考试期间浏览器里的画面可能是黑的：画面显示在代理程序窗口中。"

msgid "Перейдите к экзамену"
msgstr "进入考试"

msgid "Найдите нужный экзамен в курсе."
msgstr "在课程中找到所需考试。"

msgid "Вы увидите панель «Прокторинг УрФУ»."
msgstr "你会看到「乌拉尔联邦大学监考」面板。"

msgid "Убедитесь, что всё готово"
msgstr "确认一切就绪"

msgid "На панели должны быть выполнены все условия:"
msgstr "面板上的条件必须全部满足："

msgid "Документ загружен"
msgstr "证件已上传"

msgid "Оборудование проверено"
msgstr "设备已检查"

msgid "Запись на сегодня подтверждена"
msgstr "已确认预约为今天"

msgid "Exam Guard подключён"
msgstr "Exam Guard 已连接"

msgid "Начните экзамен в браузере"
msgstr "在浏览器中开始考试"

msgid "Когда агент подключён, начните экзамен на странице курса. Не закрывайте Exam Guard до отправки попытки."
msgstr "代理程序连接后，在课程页面开始考试。在答卷提交之前不要关闭 Exam Guard。"

msgid "Не закрывайте Exam Guard во время экзамена!"
msgstr "考试期间不要关闭 Exam Guard！"

msgid "Если закрыть Exam Guard, пропадёт сеть или откроется второй браузер, запрещённая программа или запрещённое расширение, попытка аннулируется. Новая вкладка в том же окне браузера сама по себе попытку не отменяет, но она видна на записи экрана."
msgstr "如果关闭 Exam Guard、网络中断，或打开第二个浏览器、被禁止的程序或被禁止的扩展，本次尝试将作废。同一浏览器窗口中的新标签本身不会取消尝试，但会显示在屏幕录像中。"

msgid "Правила во время экзамена"
msgstr "考试期间的规则"

msgid "Exam Guard не закрывает другие сайты за вас. Второй браузер, запрещённая программа или запрещённое расширение аннулируют начатую попытку. Нарушения правил также фиксируются на записи."
msgstr "Exam Guard 不会替你关闭其他网站。第二个浏览器、被禁止的程序或被禁止的扩展会使已开始的尝试作废。违规也会记录在录像中。"

msgid "Разрешено"
msgstr "允许"

msgid "Запрещено"
msgstr "禁止"

msgid "Часто задаваемые вопросы"
msgstr "常见问题"

msgid "Exam Guard не запускается или антивирус блокирует запись"
msgstr "Exam Guard 无法启动，或杀毒软件阻止录制"

msgid "В браузере чёрный квадрат вместо камеры"
msgstr "浏览器里摄像头位置是黑块"

msgid "Скачайте ExamUrFU заново со страницы экзамена и запустите его"
msgstr "从考试页面重新下载 ExamUrFU 并启动它"

msgid "Выключите антивирус и не включайте его до конца экзамена, пока попытка не будет отправлена."
msgstr "请关闭杀毒软件，在考试结束且答卷提交之前不要重新打开。"

msgid "Нажмите <strong>«Завершить экзамен»</strong> в интерфейсе курса"
msgstr "在课程界面点击<strong>「结束考试」</strong>"

msgid "Перезагрузите компьютер и откройте только один браузер"
msgstr "重启电脑，并且只打开一个浏览器"

msgid "Во время экзамена камеру держит Exam Guard. Смотрите картинку в окне агента. В браузере превью нужно только на проверке оборудования, до начала записи."
msgstr "考试期间摄像头由 Exam Guard 占用。请看代理程序窗口中的画面。浏览器预览只用于开始录制前的设备检查。"

msgid "В Windows откройте <em>Параметры → Конфиденциальность → Камера/Микрофон</em> и разрешите доступ приложениям."
msgstr "在 Windows 中打开<em>设置 → 隐私 → 摄像头/麦克风</em>，并允许应用访问。"

msgid "Закройте другие программы, которые заняли камеру, и нажмите «Применить» в Exam Guard."
msgstr "关闭占用摄像头的其他程序，并在 Exam Guard 中点击「应用」。"

msgid "Не могу начать запись — кнопка неактивна"
msgstr "无法开始录制——按钮不可用"

msgid "Экзамен прервался: закрылся Exam Guard или пропал интернет"
msgstr "考试中断：Exam Guard 已关闭或网络中断"

msgid "Ошибка «Начать запись можно только в день записи»"
msgstr "错误「只能在预约当天开始录制」"

msgid "Нужна помощь?"
msgstr "需要帮助？"

msgid "Если у вас возникли технические проблемы или вопросы по прокторингу:"
msgstr "如果监考出现技术问题或疑问："

msgid "При обращении укажите: вашу почту, название курса."
msgstr "联系时请注明你的邮箱和课程名称。"

msgid "Смотреть на экран и клавиатуру"
msgstr "看屏幕和键盘"

msgid "Пить воду из прозрачной бутылки"
msgstr "用透明瓶子喝水"

msgid "Использовать встроенный калькулятор (если предусмотрено)"
msgstr "使用内置计算器（如果考试提供）"

msgid "Черновик на бумаге"
msgstr "纸质草稿纸"

msgid "Покидать рабочее место / уходить из кадра"
msgstr "离开座位或离开画面"

msgid "Разговаривать с кем-либо, получать подсказки третьих лиц"
msgstr "与他人交谈或接受他人提示"

msgid "Использовать телефон или второе устройство (планшет, второй компьютер и т.д.)"
msgstr "使用手机或第二台设备（平板、另一台电脑等）"

msgid "Использовать наушники"
msgstr "使用耳机"

msgid "Присутствие посторонних в комнате"
msgstr "房间里有其他人"

msgid "Читать вопросы вслух"
msgstr "大声朗读题目"

msgid "Пользоваться шпаргалками и конспектами"
msgstr "使用小抄和笔记"

msgid "Фотографировать/переписывать задания, фиксировать вопросы любым способом"
msgstr "拍摄或抄录题目，以任何方式记录问题"

msgid "Использовать программы записи/трансляции/удалённого доступа (OBS, Discord, Skype, Zoom/Teams, AnyDesk/TeamViewer/Radmin и т.п.)"
msgstr "使用录制、直播或远程访问软件（OBS、Discord、Skype、Zoom/Teams、AnyDesk/TeamViewer/Radmin 等）"

msgid "Использовать чужие коды/попытки или материалы других слушателей"
msgstr "使用他人的代码、尝试或材料"

msgid "Держать открытым второй браузер или запрещённое расширение"
msgstr "保持第二个浏览器或被禁止的扩展处于打开状态"

msgid "Сдавать экзамен из виртуальной машины или через удалённый рабочий стол"
msgstr "在虚拟机中或通过远程桌面参加考试"

msgid "Обязательные условия"
msgstr "必要条件"

msgid "Обеспечьте достаточное освещение (не сидите спиной к окну/лампе), минимальный шум."
msgstr "保证足够照明（不要背对窗户或灯），并尽量减少噪音。"

msgid "Не закрывайте камеру и не покидайте зону видимости камеры во время экзамена."
msgstr "考试期间不要遮挡摄像头，也不要离开摄像头视野。"

msgid "Оборудование и рабочее место"
msgstr "设备与座位"

msgid "Используйте одну клавиатуру и одну мышь (без дополнительных устройств ввода)."
msgstr "只使用一个键盘和一个鼠标（不要使用额外的输入设备）。"

msgid "По запросу проктора будьте готовы показать в камеру рабочее место: стол, область слева/справа от монитора и пространство вокруг, чтобы подтвердить отсутствие посторонних людей и материалов."
msgstr "如监考人员要求，请用摄像头展示工位：桌子、显示器左右区域和周围空间，以确认没有其他人和材料。"

msgid "Черновик"
msgstr "草稿纸"

msgid "Перед началом экзамена покажите в камеру, что черновик чистый (по возможности — обе стороны листа)."
msgstr "考试开始前，向摄像头展示草稿纸是空白的（尽量展示正反两面）。"

msgid "После завершения экзамена покажите черновик в камеру по запросу (для подтверждения, что вопросы не были зафиксированы)."
msgstr "考试结束后，按要求向摄像头展示草稿纸，以确认没有记下题目。"

msgid "Если правила нарушены"
msgstr "如果违反规则"

msgid "В случае выявления нарушений попытка может быть признана использованной, а итоговый контроль — несданным."
msgstr "如发现违规，该次尝试可能被视为已使用，结业考核视为未通过。"

msgid "Завершение экзамена"
msgstr "结束考试"

msgid "Завершите все задания экзамена"
msgstr "完成全部考试题目"

msgid "Дождитесь, пока попытка будет отправлена"
msgstr "等到本次尝试已经提交"

msgid "Только после этого закройте Exam Guard"
msgstr "然后再关闭 Exam Guard"

msgid "Сначала отправьте экзамен в браузере и только потом закрывайте Exam Guard. Если закрыть агент раньше, попытка аннулируется, и кнопка завершения её не восстановит."
msgstr "先在浏览器中提交考试，然后再关闭 Exam Guard。如果提前关闭代理程序，尝试会作废，结束按钮也无法恢复。"

msgid "Что происходит после завершения?"
msgstr "结束后会发生什么？"

msgid "Ваша видеозапись и ответы отправляются на проверку. Проктор просмотрит запись и примет решение в течении 5 рабочих дней."
msgstr "你的录像和答案会送去审核。监考人员会查看录像，并在 5 个工作日内作出决定。"

msgid "Перезагрузите компьютер"
msgstr "重启电脑"

msgid "Проверьте выполнение всех условий:"
msgstr "请检查是否满足全部条件："

msgid "Загружен студенческий билет"
msgstr "已上传学生证"

msgid "Пройдена проверка оборудования"
msgstr "已完成设备检查"

msgid "Вы записаны на сегодняшнюю дату"
msgstr "你的预约是今天"

msgid "Если все условия выполнены, но кнопка неактивна — обновите страницу (F5)."
msgstr "如果条件都已满足但按钮仍不可用，请刷新页面（F5）。"

msgid "Если попытка уже начата, закрытие Exam Guard, обрыв связи, второй браузер, запрещённая программа или запрещённое расширение аннулируют её. Напишите в поддержку и не нажимайте «Завершить экзамен» в надежде отправить аннулированную попытку."
msgstr "如果尝试已经开始，关闭 Exam Guard、断网、第二个浏览器、被禁止的程序或扩展都会使其作废。请联系支持，不要指望点击「结束考试」来提交已作废的尝试。"

msgid "Если экзамен ещё не начат, снова откройте страницу, запустите Exam Guard и введите новый код."
msgstr "如果考试尚未开始，请重新打开页面，启动 Exam Guard 并输入新的代码。"

msgid "Вы пытаетесь начать экзамен в день, отличный от забронированного."
msgstr "你试图在非预约日期开始考试。"

msgid "Проверьте дату своей записи в виджете «Запись на прокторинг»"
msgstr "请在「预约监考」组件中查看你的预约日期"

msgid "Если нужно перенести — откройте календарь и выберите другую дату"
msgstr "如需改期，请打开日历并选择其他日期"

msgid "Если сегодня — ваш день, но ошибка всё равно появляется, обновите страницу"
msgstr "如果今天就是你的日期但错误仍然出现，请刷新页面"

msgid "Скопировать email"
msgstr "复制邮箱"

msgid "Скопировано!"
msgstr "已复制！"

msgid "قبل сдачей экзамена необходимо <strong>записаться на конкретную дату</strong> через календарь бронирования. Начать экзамен можно только в день записи."
msgstr "考试前必须通过预约日历<strong>预约具体日期</strong>。只能在预约当天开始考试。"

msgid "Планшеты и телефоны <strong>не поддерживаются</strong>"
msgstr "平板和手机<strong>不受支持</strong>"

msgid "<strong>Черновик на бумаге</strong> — при соблюдении правил ниже"
msgstr "<strong>纸质草稿纸</strong>——须遵守以下规则"

msgid "<strong>Не отключайте микрофон</strong> во время экзамена и убедитесь, что вас слышно."
msgstr "考试期间<strong>不要关闭麦克风</strong>，并确认能听到你的声音。"

msgid "Используйте для идентификации <strong>оригинал</strong> документа (студенческий билет) и предъявляйте по требованию."
msgstr "身份核验请使用证件<strong>原件</strong>（学生证），并在要求时出示。"

msgid "Используйте <strong>только один</strong> монитор/экран вывода изображения. Если подключён второй монитор — отключите его и перезагрузите компьютер."
msgstr "请<strong>只使用一台</strong>显示器。如果接了第二台，请断开并重启电脑。"

msgid "На черновике <strong>запрещено</strong> фиксировать текст заданий/вопросов и варианты ответов."
msgstr "草稿纸上<strong>禁止</strong>抄录题目、问题或选项。"

